<UserControl x:Class="PortfolioTracker.Views.AddOrder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PortfolioTracker.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:Background="White"  Height="450" Width="700">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="7*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Content="Import" FontSize="22" Margin="5,5,5,5"/>
                <Button Grid.Column="1" Content="Export" FontSize="22" Margin="5,5,5,5"/>
            </Grid>
            <StackPanel Grid.Row="1">
                <Label Content="Add manually" Height="42" FontSize="22" HorizontalContentAlignment="Center" Margin="0,5,0,0"/>
                <ComboBox Width="120" Height="27"/>
                <Label Content="Ticker" Height="26" FontSize="12" HorizontalContentAlignment="Center"/>
                <TextBox TextWrapping="Wrap" Text="" HorizontalContentAlignment="Center" Width="120" Height="27" FontSize="16"/>
                <Label Content="Amount" Height="26" FontSize="12" HorizontalContentAlignment="Center"/>
                <TextBox TextWrapping="Wrap" Text="" Width="120" Height="27" FontSize="16" TextAlignment="Center"/>
                <DatePicker Margin="0,5,0,0" Width="120" Height="27"/>
                <Label Content="Price" Height="26" FontSize="12" HorizontalContentAlignment="Center"/>
                <TextBox TextWrapping="Wrap" Text="" Width="120" Height="27" TextAlignment="Center" FontSize="16"/>
                <Button Content="Add" Width="194" Margin="0,25,0,0" Height="45" FontSize="22"/>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
