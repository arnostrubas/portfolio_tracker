<UserControl x:Class="PortfolioTracker.Views.AddPortfolio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PortfolioTracker.Views"
             mc:Ignorable="d" 
             
             d:DesignHeight="450" d:DesignWidth="800" d:Background="#F0F8FF" Height="450" Width="700">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="57*"/>
            <ColumnDefinition Width="143*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1">
            <Label Foreground="#1E3A8A" FontWeight="Bold" Content="Name of the portfolio" HorizontalContentAlignment="Center" Height="39" FontSize="18"/>
            <TextBox Background="#BFDBFE" TextWrapping="Wrap" Text="{Binding Name}" Width="220" Height="47" FontSize="18" HorizontalContentAlignment="Center" Margin="0,10,0,0"/>
            <Label Foreground="#1E3A8A" FontWeight="Bold" Content="Write name of existing portfolio to remove it&#x9;&#xD;&#xA;(have other portfolio selected while deleting)&#xD;&#xA;" HorizontalContentAlignment="Center" Height="61" FontSize="18" Margin="0,10,0,0" Width="403"/>
            <Button Background="#34D399" Foreground="Black" Content="Add Portfolio" Command="{Binding AddPortfolioCommand}" Height="69" Margin="0,30,0,0" Width="161" FontSize="18" BorderBrush="{x:Null}"/>
            <Button Background="#F87171" Foreground="Black" BorderBrush="{x:Null}" Content="Remove Portfolio" Command="{Binding DeletePortfolioCommand}" Height="69" Margin="0,30,0,0" Width="161" FontSize="18"/>
        </StackPanel>
        <StackPanel  Grid.Column="0" Margin="5">
            <Label Foreground="#1E3A8A" FontWeight="Bold" Content="All Portfolios" HorizontalContentAlignment="Center" Height="39" FontSize="18"/>
            <ListView ItemsSource="{Binding Portfolios}" HorizontalContentAlignment="Center" Background="#E0F2FE" BorderThickness="1" 
                      BorderBrush="{x:Null}" IsHitTestVisible="False" Margin="0,0,10,0">
                <ListView.Resources>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="IsHitTestVisible" Value="False"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Cursor" Value="None"/>
                    </Style>

                    <Style TargetType="GridViewColumnHeader">
                        <Setter Property="Background" Value="#BFDBFE"/>
                        <Setter Property="Foreground" Value="#1E3A8A"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{x:Null}"/>
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="IsHitTestVisible" Value="False"/>
                    </Style>
                </ListView.Resources>

                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Portfolio Name" DisplayMemberBinding="{Binding}" Width="Auto"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
    </Grid>
</UserControl>
