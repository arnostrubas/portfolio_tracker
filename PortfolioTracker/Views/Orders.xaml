<UserControl x:Class="PortfolioTracker.Views.Orders"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PortfolioTracker.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:Background="White"  Height="450" Width="800">
    <StackPanel>
        <Label Content="All orders" Height="33" FontSize="16" HorizontalContentAlignment="Left" Margin="0,5,0,0"/>
        <ListView d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,0,10,0">
            <ListView.View>
                <GridView>
                    <GridViewColumn DisplayMemberBinding="{Binding Ticker}" Header="Company" />
                    <GridViewColumn DisplayMemberBinding="{Binding OrderType}" Header="Type" />
                    <GridViewColumn DisplayMemberBinding="{Binding Amount}" Header="Amount" />
                    <GridViewColumn DisplayMemberBinding="{Binding Price}" Header="Price" />
                    <GridViewColumn DisplayMemberBinding="{Binding Date}" Header="Name" />
                    <GridViewColumn Header="   ">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="X" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}" HorizontalContentAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </StackPanel>
</UserControl>
